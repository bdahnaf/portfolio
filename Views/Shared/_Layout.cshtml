<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>bdahnaf (Ahnaf Shahriar) / Portfolio</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
                body {
            background-color: #0d1117;
            color: #c9d1d9;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        }

        /* Navbar */
        .gh-nav {
            background-color: #161b22;
            border-bottom: 1px solid #30363d;
            padding: 12px 24px;
        }

        /* Sidebar Profile */
        .profile-pic {
            width: 100%;
            aspect-ratio: 1/1;
            border-radius: 50%;
            border: 1px solid #30363d;
            background: #161b22;
            overflow: hidden;
        }

        .profile-pic i {
            font-size: 9rem;
            color: #30363d;
        }

        /* README Container */
        .readme-container {
            border: 1px solid #30363d;
            border-radius: 6px;
            padding: 32px;
            background: transparent;
            margin-bottom: 24px;
        }

        .readme-header {
            border-bottom: 1px solid #30363d;
            margin-bottom: 20px;
            padding-bottom: 10px;
            color: #8b949e;
            font-size: 14px;
            display: flex;
            align-items: center;
        }

        /* Typography */
        .readme-content h1,
        .readme-content h2,
        .readme-content h3 {
            color: #e6edf3;
            border-bottom: 1px solid #21262d;
            padding-bottom: 8px;
            margin-top: 24px;
            margin-bottom: 16px;
        }

        .readme-content p,
        .readme-content li {
            line-height: 1.6;
            font-size: 15px;
        }

        .text-blue {
            color: #58a6ff;
        }

        /* Project Repository Cards */
        .repo-card {
            background: transparent;
            border: 1px solid #30363d;
            border-radius: 6px;
            padding: 16px;
            height: 100%;
            transition: 0.2s;
        }

        .repo-card:hover {
            border-color: #8b949e;
            background: rgba(255, 255, 255, 0.02);
        }

        .repo-link {
            color: #58a6ff;
            font-weight: 600;
            text-decoration: none;
            font-size: 14px;
        }

        .repo-link:hover {
            text-decoration: underline;
        }

        .lang-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 4px;
        }

        /* Sidebar Badges */
        .cert-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 13px;
            margin-bottom: 12px;
            opacity: 0.85;
        }

        .cert-icon {
            color: #f2cc60;
            font-size: 1.1rem;
        }

        /* Tabs */
        .gh-tabs {
            border-bottom: 1px solid #30363d;
            margin-bottom: 24px;
        }

        .gh-tab {
            padding: 8px 16px;
            border-bottom: 2px solid transparent;
            color: #c9d1d9;
            text-decoration: none;
            display: inline-block;
            font-size: 14px;
        }

        .gh-tab.active {
            border-bottom-color: #f78166;
            font-weight: 600;
        }

        .gh-tab i {
            margin-right: 8px;
            opacity: 0.6;
        }
    </style>
</head>

<body>
    @RenderBody()

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
