    @section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            fetch('/api/coding-stats')
                .then(response => response.json())
                .then(data => {
                    const container = document.getElementById("codingStatsContainer");
                    container.innerHTML = ""; // Clear the loader

                    if (!data || data.length === 0) {
                        container.innerHTML = "<span class='small text-secondary'>Stats unavailable.</span>";
                        return;
                    }

                    data.forEach(lang => {
                        // Assign colors based on language
                        let color = "#8b949e";
                        if (lang.name === "C#") color = "#178600";
                        if (lang.name === "PHP") color = "#4F5D95";
                        if (lang.name === "JavaScript") color = "#f1e05a";
                        if (lang.name === "HTML") color = "#e34c26";

                        const html = `
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-bold text-secondary">${lang.name}</span>
                                    <span class="text-secondary" style="font-size: 0.8em;">${lang.text}</span>
                                </div>
                                <div class="progress" style="height: 6px; background-color: rgba(255,255,255,0.05);">
                                    <div class="progress-bar" role="progressbar" style="width: ${lang.percent}%; background-color: ${color};" aria-valuenow="${lang.percent}" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        `;
                        container.insertAdjacentHTML('beforeend', html);
                    });
                })
                .catch(error => {
                    document.getElementById("codingStatsContainer").innerHTML = "<span class='small text-danger'>Failed to load stats.</span>";
            });
            // Fetch Spotify Status
            // Only Currently Playing
            // fetch('/api/spotify/now-playing')
            //     .then(response => response.json())
            //     .then(data => {
            //         if (data.isPlaying) {
            //             // Unhide the widget
            //             document.getElementById("spotifyWidget").classList.remove("d-none");
                        
            //             // Inject the data
            //             document.getElementById("spotifyAlbumArt").src = data.albumArt;
            //             document.getElementById("spotifyLink").innerText = data.title;
            //             document.getElementById("spotifyLink").href = data.spotifyUrl;
            //             document.getElementById("spotifyArtist").innerText = data.artist;
            //         }
            //     })
            //     .catch(err => console.error("Spotify API error", err));

            // Fetch Spotify Dashboard
            fetch('/api/spotify/dashboard')
            .then(response => {
                if (!response.ok) throw new Error(`Server returned status: ${response.status}`);
                return response.json();
            })
            .then(data => {
                if (data.hasError || !data.success) {
                    console.error("🚨 BACKEND SPOTIFY ERROR:", data.errorMessage);
                    return;
                }

                // Unhide the main widget container (because Top Tracks are always there)
                document.getElementById("spotifyWidget").classList.remove("d-none");

                // Handle Now Playing
                if (data.nowPlaying && data.nowPlaying.isPlaying) {
                    document.getElementById("spotifyNowPlayingContainer").classList.remove("d-none");
                    document.getElementById("spotifyNpArt").src = data.nowPlaying.albumArt;
                    document.getElementById("spotifyNpTitle").innerText = data.nowPlaying.title;
                    document.getElementById("spotifyNpTitle").href = data.nowPlaying.spotifyUrl;
                    document.getElementById("spotifyNpArtist").innerText = data.nowPlaying.artist;
                }

                // Handle Top Tracks
                const ttList = document.getElementById("spotifyTopTracksList");
                ttList.innerHTML = ""; 
                
                data.topTracks.forEach((track, index) => {
                    const trackHtml = `
                        <a href="${track.spotifyUrl}" target="_blank" class="d-flex align-items-center text-decoration-none rounded p-1" style="background-color: rgba(255,255,255,0.02); transition: background-color 0.2s;">
                            <span class="text-secondary fw-bold me-2 ms-1" style="font-size: 0.7rem;">${index + 1}</span>
                            <img src="${track.albumArt}" alt="${track.title}" class="rounded" style="width: 32px; height: 32px; object-fit: cover;">
                            <div class="ms-2 overflow-hidden">
                                <p class="mb-0 text-white text-truncate fw-bold lh-1" style="font-size: 0.8rem;">${track.title}</p>
                                <p class="mb-0 mt-1 text-secondary text-truncate lh-1" style="font-size: 0.7rem;">${track.artist}</p>
                            </div>
                        </a>
                    `;
                    ttList.insertAdjacentHTML('beforeend', trackHtml);
                });
            })
            .catch(err => console.error("🚨 FRONTEND SPOTIFY FETCH ERROR:", err));
            // Fetch Steam Status (Top 2 Games & Profile)
            fetch('/api/steam/top-games')
                .then(response => {
                    if (!response.ok) throw new Error(`Server returned status: ${response.status}`);
                    return response.json();
                })
                .then(data => {
                    if (data.hasError || !data.success) {
                        console.error("🚨 BACKEND STEAM ERROR:", data.errorMessage);
                        return;
                    }

                    // Unhide the widget and set button links
                    document.getElementById("steamWidget").classList.remove("d-none");
                    document.getElementById("steamProfileBtn").href = data.profileUrl;
                    document.getElementById("steamAddBtn").href = data.addFriendUrl;

                    const container = document.getElementById("steamGamesContainer");
                    container.innerHTML = ""; // Clear out any old content

                    // Loop through the games and generate the HTML
                    data.games.forEach(game => {
                        const gameHtml = `
                            <a href="${game.storeUrl}" target="_blank" class="d-flex align-items-center text-decoration-none rounded p-1" style="background-color: rgba(255,255,255,0.05); transition: background-color 0.2s;">
                                <img src="${game.bannerUrl}" alt="${game.title}" class="rounded" style="width: 80px; height: 38px; object-fit: cover;">
                                <div class="ms-2 overflow-hidden">
                                    <p class="mb-0 text-white text-truncate fw-bold lh-1" style="font-size: 0.8rem;">${game.title}</p>
                                    <p class="mb-0 mt-1 text-truncate" style="font-size: 0.7rem; color: #8f98a0;">${game.hoursPlayed} hrs on record</p>
                                </div>
                            </a>
                        `;
                        container.insertAdjacentHTML('beforeend', gameHtml);
                    });
                })
                .catch(err => console.error("🚨 FRONTEND STEAM FETCH ERROR:", err));
        });
    </script>
